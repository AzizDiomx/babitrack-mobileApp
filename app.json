{
  "expo": {
    "name": "BabiTrack",
    "slug": "babitrack",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babitrack.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autorisez BabiTrack à utiliser la caméra pour scanner les QR codes de présence des passagers."
      }
    },
    "android": {
      "package": "com.babitrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAGgwpaVkbzs7GZn3qHUm7Cw3Z60G_gPmo"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez BabiTrack à utiliser la caméra pour scanner les QR codes d'accès des passagers."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autorisez BabiTrack à accéder à votre position pour le suivi du trajet en temps réel.",
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1695767b-7aee-487c-a388-59e2b85d72a8"
      }
    },
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android"
    ]
  }
}